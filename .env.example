# ============================================================
# YiBot 环境变量模板（复制为 .env 后填写，.env 不入库）
# 注意：所有密钥仅通过环境变量注入，禁止写入任何代码文件
# ============================================================

# ---- LLM（智谱 GLM）----
GLM_API_KEY=
GLM_MODEL_ID=
GLM_BASE_URL=

# ---- 阿里云百炼 ----
DASHSCOPE_API_KEY=

# ---- 搜索工具 ----
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ---- 高德开放平台（P0 已轮换的新 Key）----
AMAP_KEY=

# ---- MySQL ----
DATABASE_URI=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 网关（deploy/ APISIX standalone）----
# APISIX_UPSTREAM_HOST=host.docker.internal   # 容器访问宿主后端 8000
# APISIX_REDIS_HOST=host.docker.internal      # limit-count 共享计数 Redis
# APISIX_REDIS_PASSWORD=                      # 与宿主 Redis requirepass 一致（未设密码则留空）
# APISIX_ADMIN_KEY=                           # etcd 模式 Admin API key（scripts/apisix_admin_setup.py）

# ---- Nacos / MCP 网关 ----
NACOS_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=

